#!/bin/bash
# Click derecho > Scripts > Analizar espacio
# Carpeta local -> gdu (TUI). Carpeta dentro del teléfono (MTP) -> android-du vía adb.
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:$PATH"
dec() { printf '%b' "$(echo "$1" | sed 's|%|\\x|g')"; }

sel_uri="${NAUTILUS_SCRIPT_SELECTED_URIS%%$'\n'*}"
sel_path="${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS%%$'\n'*}"
uri="${sel_uri:-$NAUTILUS_SCRIPT_CURRENT_URI}"

if [[ "$uri" == mtp://* ]]; then
  rest="$(dec "${uri#mtp://*/}")"          # "Almacenamiento interno/DCIM/..."
  sub="${rest#*/}"; [ "$sub" = "$rest" ] && sub=""
  remote="/sdcard${sub:+/$sub}"
  exec setsid xdg-terminal-exec bash -c 'android-du "$1" 40; echo; read -n1 -rp "Enter para cerrar..."' _ "$remote"
fi

target="$sel_path"
[ -z "$target" ] && target="$(dec "${NAUTILUS_SCRIPT_CURRENT_URI#file://}")"
[ -f "$target" ] && target="$(dirname "$target")"
exec setsid xdg-terminal-exec bash -c 'gdu "$1" || read -n1 -rp "Error. Enter para cerrar..."' _ "$target"
